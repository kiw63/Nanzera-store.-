rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================================================
       ADMIN CHECK
       ========================================================= */

    function isAdmin() {
      return request.auth != null
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        );
    }


    /* =========================================================
       PRODUCTS
       ========================================================= */

    match /products/{productId} {

      // Pelanggan boleh melihat produk
      allow read: if true;

      // Hanya admin yang boleh membuat,
      // mengubah, atau menghapus produk
      allow create, update, delete: if isAdmin();
    }


    /* =========================================================
       VOUCHERS
       ========================================================= */

    match /vouchers/{voucherId} {

      // Admin boleh membuat voucher
      allow create: if isAdmin();

      // Admin boleh mengubah voucher
      allow update: if isAdmin();

      // Admin boleh menghapus voucher
      allow delete: if isAdmin();

      // Pelanggan boleh membaca satu voucher
      // berdasarkan kode voucher.
      // Ini diperlukan agar pelanggan bisa
      // memeriksa kode voucher saat checkout.
      allow get: if true;

      // Daftar semua voucher hanya boleh dibaca admin.
      // Ini diperlukan untuk halaman Voucher di Admin Panel.
      allow list: if isAdmin();
    }


    /* =========================================================
       TRANSACTIONS
       ========================================================= */

    match /transactions/{invoiceId} {

      /*
        Customer hanya boleh membuat order baru
        dengan kondisi pembayaran awal belum dibayar.
      */

      allow create: if
        request.resource.data.invoice_id == invoiceId

        && request.resource.data.status == "WAITING_PAYMENT"

        && request.resource.data.payment_status == "UNPAID"

        && request.resource.data.quantity is int

        && request.resource.data.quantity > 0

        && request.resource.data.product_id is string

        && request.resource.data.unit_price ==
          get(
            /databases/$(database)/documents/products/$(request.resource.data.product_id)
          ).data.price

        && request.resource.data.total_price ==
          request.resource.data.unit_price *
          request.resource.data.quantity

        && request.resource.data.roblox_username is string

        && request.resource.data.customer_email is string;


      /*
        Customer boleh mencari transaksi berdasarkan
        invoice ID.
      */

      allow get: if true;


      /*
        Hanya admin yang boleh membaca seluruh daftar
        transaksi.
      */

      allow list: if isAdmin();


      /*
        Hanya admin yang boleh mengubah atau menghapus
        transaksi.
      */

      allow update, delete: if isAdmin();
    }


    /* =========================================================
       ADMINS
       ========================================================= */

    match /admins/{uid} {

      /*
        Admin hanya boleh membaca dokumen admin miliknya
        sendiri.
      */

      allow read:
        if request.auth != null
        && request.auth.uid == uid;


      /*
        Dokumen admin tidak boleh dibuat/diubah dari website.
      */

      allow write: if false;
    }


    /* =========================================================
       DEFAULT DENY
       ========================================================= */

    /*
      Semua collection lain ditolak secara default.
    */

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
